# Copie para ".env" (na mesma pasta) e preencha. O arquivo .env NÃO vai para o Git.

# Domínio que aponta para o IP da VPS (registro DNS tipo A). Ex.: papo.seudominio.com
PAPO_DOMAIN=papo.exemplo.com

# Código para criar a PRIMEIRA conta (a dona do servidor). Gere um com: openssl rand -hex 16
PAPO_SETUP_CODE=troque-por-um-codigo-longo

# Chave e segredo do LiveKit (inventados por você, só o servidor usa).
# Gere com: openssl rand -hex 8   (chave)   e   openssl rand -hex 32   (segredo)
LIVEKIT_API_KEY=papo-troque
LIVEKIT_API_SECRET=troque-por-um-segredo-bem-longo

# Opcional: versão do LiveKit. Se a tag não existir no Docker Hub, use "latest".
# LIVEKIT_VERSION=v1.13.10
