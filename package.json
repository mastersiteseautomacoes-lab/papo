{
  "name": "papo",
  "private": true,
  "version": "0.7.0",
  "description": "Papo — sessões para compartilhar tela, câmera e áudio com quem tem o código",
  "author": "Papo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "start": "npm run build && tsx server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=build/server.cjs"
  },
  "devDependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "http-proxy": "^1.18.1",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^1.59.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
